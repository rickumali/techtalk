---
title: "All Posts"
layout: list.njk
eleventyExcludeFromCollections: true
permalink: "/index.html"
---
<ul class="post-list">
{%- for post in collections.storyPosts | reverse -%}
  <li>
    <time>{{ post.data.date | readableDate }}</time>
    &mdash;
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    {% if post.data.excerpt %}<p class="excerpt">{{ post.data.excerpt }}</p>{% endif %}
  </li>
{%- endfor -%}
</ul>
