---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | slug }}/index.html"
layout: list.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "Tag: {{ tag }}"
---
<h1>Tag: {{ tag }}</h1>
<ul class="post-list">
{%- for post in collections[tag] | reverse -%}
  {%- if post.data.nodeType == "story" -%}
  <li>
    <time>{{ post.data.date | readableDate }}</time>
    &mdash;
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    {% if post.data.excerpt %}<p class="excerpt">{{ post.data.excerpt | safe }}</p>{% endif %}
  </li>
  {%- endif -%}
{%- endfor -%}
</ul>
